# Copy this file to .env and fill in real values. .env is git-ignored.

# Port the Express API listens on (default: 3001)
PORT=3001

# Supabase credentials — NOT required for the scaffold to run locally.
# Leave blank until a Supabase project is provisioned.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
