# Copy this file to .env and fill in real values. .env is git-ignored.

# Port the Express API listens on (default: 3001)
PORT=3001

# Supabase credentials — NOT required for the scaffold to run locally.
# Leave blank until a Supabase project is provisioned.
# From Supabase Dashboard → Project Settings → API Keys:
#   SUPABASE_URL  = Project URL          (https://<ref>.supabase.co)
#   SUPABASE_ANON_KEY = anon public key  (or publishable key)
# NOTE: without Row Level Security enabled on these tables, the anon key can
# read all rows — acceptable for disposable test projects only. RLS/policy
# work is deferred until the auth decision (see docs/OPEN_QUESTIONS.md).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
